# /etc/mcp-server-webos/env: read by run.sh (root:mcp-webos, mode 0640).
# Plain KEY=value lines. Nothing here is a secret (the AUD tag is not one), but keep it 0640.
# The TVs and their client keys live in /var/lib/mcp-server-webos (written by `pair`).

# Where to listen: the address the tunnel route's service URL points at.
# 127.0.0.1 only if cloudflared runs directly in this LXC. If cloudflared runs in
# a Docker container (here or elsewhere), "localhost" in its route is that
# container: use this LXC's address (or 172.17.0.1, the Docker bridge, if the
# container is on this host), in both the route and here. A non-loopback bind
# requires the Access settings below.
MCP_HTTP_BIND=127.0.0.1
MCP_HTTP_PORT=8715
MCP_HTTP_PATH=/webos/mcp
# REQUIRED behind Cloudflare: the public hostname. The server checks the Host
# header, and without this every request through the tunnel gets HTTP 421.
#MCP_PUBLIC_HOSTS=mcp.example.com

# Cloudflare Access (required for any non-loopback bind). Both come from the
# Access application: Zero Trust > Settings shows the team domain; the app's
# overview shows its Application Audience (AUD) tag.
#CF_ACCESS_TEAM_DOMAIN=example.cloudflareaccess.com
#CF_ACCESS_AUD=<the Access application's AUD tag>
#MCP_ALLOWED_EMAILS=you@example.com

# Optional
#WEBOS_DRY_RUN=1        # read the TVs, send nothing that changes anything
#WEBOS_DEBUG=1          # log protocol traffic (redacted)
#MCP_SERVE_ARGS=--no-redact
