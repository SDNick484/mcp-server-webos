#!/sbin/openrc-run
# OpenRC service for mcp-server-webos (Streamable HTTP), e.g. in an Alpine LXC.
# Installed as /etc/init.d/mcp-server-webos by install.sh. HTTP and Cloudflare
# Access settings live in /etc/mcp-server-webos/env; the pairing credentials
# and config.json in /var/lib/mcp-server-webos (the service user's own, 0700,
# since the server rewrites config.json when a TV's address changes).

name="mcp-server-webos"
description="MCP server for LG webOS TVs, over Streamable HTTP"

# supervise-daemon restarts the server if it exits (respawn_* below).
supervisor="supervise-daemon"
# run.sh loads /etc/mcp-server-webos/env, then execs `mcp-server-webos serve --http`.
command="/opt/mcp-server-webos/run.sh"
command_user="mcp-webos:mcp-webos"
directory="/var/lib/mcp-server-webos"
output_log="/var/log/mcp-server-webos/server.log"
error_log="/var/log/mcp-server-webos/server.log"
respawn_delay=5
respawn_max=10
respawn_period=300

# Stopping: SIGTERM, up to 15 s to shut down cleanly, then SIGKILL (OpenRC's default is SIGTERM/5).
# Shutdown is usually about 2 s, but the TVs stop one at a time, each up to 5 s plus a WebSocket
# close that isn't time-limited (aiohttp's own 10 s). So a TV that stops answering mid-shutdown
# can still end in SIGKILL.
# supervise-daemon reads this at start: the restart that installs it still stops the old way.
retry="SIGTERM/15/SIGKILL/5"

depend() {
	need net
	after firewall
}

start_pre() {
	checkpath --directory --mode 0750 --owner mcp-webos:mcp-webos /var/log/mcp-server-webos
	checkpath --directory --mode 0700 --owner mcp-webos:mcp-webos /var/lib/mcp-server-webos
}
